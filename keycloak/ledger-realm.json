{
  "realm": "ledger",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Can manage own accounts and send transfers from them" },
      { "name": "ADMIN", "description": "Can act on any account, make deposits and reverse transfers" }
    ]
  },
  "clients": [
    {
      "clientId": "ledger-api",
      "name": "Ledger API (local development)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice-dev-password", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob-dev-password", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin-user",
      "email": "admin-user@example.com",
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin-dev-password", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}
